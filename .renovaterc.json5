{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#12.0.0", ":timezone(Europe/Paris)"],
  packageRules: [
    {
      description: "Base image updates release the app once its build and test pass",
      matchFileNames: ["apps/**/Dockerfile"],
      matchManagers: ["dockerfile"],
      automerge: true,
      automergeType: "pr",
      commitMessageTopic: "{{parentDir}} base image",
      semanticCommitType: "fix",
      semanticCommitScope: "{{parentDir}}",
    },
    {
      description: "Pinned GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
    },
  ],
}
